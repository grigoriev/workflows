{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>grigoriev/renovate-config"
  ],
  "customManagers": [
    {
      "description": "The pyyaml pin of the tool list parity check in ci.yml.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "--with pyyaml==(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "pyyaml"
    }
  ]
}
